[Unit]
Description=rsched state snapshot — a dated, hard-linked backup of every data home
Documentation=file:%h/git-repos/routine-scheduler/deploy/DOCKER.md

# A failed snapshot reaches the operator's phone, because nothing else does: this unit failed every
# night from 2026-09-12 to 2026-10-01 and the silence held for nineteen nights (F602). systemd is
# the right carrier for THIS half — it still works when the scheduler daemon is down, which is
# exactly when a backup failure matters most. The daemon's own backup-watch covers the other half (a
# snapshot that stopped completing for days, filed into the health stream), so neither mechanism
# being up is a single point of silence.
OnFailure=rsched-backup-failed.service

[Service]
Type=oneshot

# The backup root: backup.sh writes snapshots/<YYYY-MM-DD> and the `latest` link under it. The
# variable keeps its name from the single mirror the root used to hold, so a host's existing
# drop-in still points where it did. Override per host with a drop-in rather than editing this:
#   systemctl --user edit rsched-backup.service
#   [Service]
#   Environment=RSCHED_MIRROR=/some/other/mount/rsched-backup
# backup.sh refuses any target on the same device as $HOME, so a share that failed to mount
# fails the unit instead of quietly filling the local disk with a copy of itself.
Environment=RSCHED_MIRROR=/mnt/sshd_volume1/rsched-backup
ExecStart=/bin/bash %h/git-repos/routine-scheduler/deploy/backup.sh ${RSCHED_MIRROR}

# The snapshot is written to a network share. If the NAS wedges mid-transfer, rsync blocks in
# uninterruptible IO forever and every later firing skips on the lock — so bound the run and
# let the next night try again. A run cut short keeps no snapshot: its half-built folder never
# takes a date, and the next run carries on in it.
#
# The bound is NOT a target for a healthy night, and 2h was set as if it were. On the sshfs share a
# run costs one round trip per FILE, not per changed byte — every unchanged file is still stat'd
# and hard-linked over SFTP — so its length follows the homes' file count (~270k on this host):
# 49 min on 2026-10-07, 1h47 by 2026-10-22, and from 2026-10-24 every night hit the 2h bound. Each
# killed run's leftovers were then deleted inside the next run's 2h, so one timeout caused the next
# (backup.sh now carries on in them instead). 4h keeps the wedge guard while a healthy night has
# room to grow; `daemon/backup_watch.ATTEMPT_BOUND_HOURS` reads an attempt older than this as
# failed, so the two must agree (tests/test_backup_watch.py holds them to it).
TimeoutStartSec=4h

# The daemon is doing real work on this box; a backup never deserves to compete with a run.
Nice=10
