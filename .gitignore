.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
*.egg-info/

# a self-audit run pointed at the source tree writes here — never commit it
audit/

# derived codebase map (library `codemap` util, regenerated at self-audit orient) — a pure
# derivation of the tree, delete-and-rebuild; committing it would only add churn
.codemap/

# quality-gate artifacts (ruff/mypy/coverage run in-repo on the server)
.ruff_cache/
.mypy_cache/
.coverage
/LEDGER.md

# Claude Code CLI writes local settings into the tree it works on — never commit it
.claude/

# host-specific resource ceilings (see file header)
docker-compose.override.yml
.audit-wt/

# The compose environment. It carries BROWSER_CDP_TOKEN — the bearer in front of the
# browser sidecar's CDP and noVNC ports — so it is a credential file, never tracked.
.env
